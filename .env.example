# Copy to .env and fill in. Never commit .env.
# Paste values as they are: no quotes and no <angle brackets>.

# --- Required ---------------------------------------------------------------

# Lemma tracing: ingest key and project ID (Lemma: Settings -> API keys)
LEMMA_API_KEY=
LEMMA_PROJECT_ID=

# Lemma MCP server key. Used by Claude Code and by scripts/export-lemma-issues.js.
LEMMA_MCP_API_KEY=

# Groq API key (free tier), used through the openai package
GROQ_API_KEY=

# --- Optional (the default is used when left empty) -------------------------

# Groq model. Default: openai/gpt-oss-120b
GROQ_MODEL=

# MongoDB connection string; MONGODB_URL is also accepted.
# Default: mongodb://localhost:27017/agent_failure_lab
MONGODB_URI=

# Server port. Default: 3000
PORT=

# Local embedding model, downloaded once. Default: Xenova/all-MiniLM-L6-v2
EMBEDDING_MODEL=

# Set to 1 to log every trace delivery (very verbose)
LEMMA_DEBUG=

# Lemma MCP endpoint. Default: https://api.uselemma.ai/mcp/
LEMMA_MCP_URL=

# Pause between questions in milliseconds.
# Defaults: ask 8000, experiment 2500, judge 2500
ASK_DELAY_MS=
EXPERIMENT_DELAY_MS=
JUDGE_DELAY_MS=

# Failure flags: set at most one to true. Default: all off. The experiment
# runner ignores these and sets its own flag per request.
STALE_DOC=
WRONG_TOOL=
HALLUCINATE=
IGNORE_RULE=
TRUNCATE=
