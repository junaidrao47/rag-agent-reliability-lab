# Copy to .env and fill in. Never commit .env.

# Lemma tracing (ingest key from Lemma: Settings -> API keys)
LEMMA_API_KEY=
LEMMA_PROJECT_ID=
# Key for the Lemma MCP server (used by Claude Code, not by the app)
LEMMA_MCP_API_KEY=
# Optional: set to 1 to log trace delivery
LEMMA_DEBUG=

# Groq (free tier), used through the openai package
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# MongoDB (MONGODB_URL is also accepted)
MONGODB_URI=mongodb://localhost:27017/agent_failure_lab

# Server
PORT=3000

# Local embedding model (downloaded once, runs on your machine)
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# scripts/ask.js: pause between questions, in milliseconds
ASK_DELAY_MS=8000

# scripts/run-experiment.js: pause between questions, in milliseconds
EXPERIMENT_DELAY_MS=2500

# Failure flags. Turn on at most one. The experiment runner ignores these and
# sets its own flag per request.
STALE_DOC=false
WRONG_TOOL=false
HALLUCINATE=false
IGNORE_RULE=false
TRUNCATE=false
