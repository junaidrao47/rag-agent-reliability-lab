{
  "name": "rag-agent-reliability-lab",
  "version": "1.0.0",
  "description": "An open test of whether Lemma catches silent AI-agent failures: a support RAG agent with five injected bugs, an LLM judge and a scorecard.",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "seed": "node scripts/seed.js",
    "dev": "node --watch src/server.js",
    "ask": "node scripts/ask.js",
    "experiment": "node scripts/run-experiment.js",
    "judge": "node scripts/judge.js",
    "export-issues": "node scripts/export-lemma-issues.js",
    "scorecard": "node scripts/scorecard.js"
  },
  "keywords": [
    "ai-agents",
    "rag",
    "observability",
    "llm-evaluation",
    "lemma",
    "silent-failures"
  ],
  "author": "Rao Muhammad Junaid",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/junaidrao47/rag-agent-reliability-lab.git"
  },
  "homepage": "https://github.com/junaidrao47/rag-agent-reliability-lab#readme",
  "bugs": {
    "url": "https://github.com/junaidrao47/rag-agent-reliability-lab/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@uselemma/tracing": "^7.12.5",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "mongodb": "^7.8.0",
    "openai": "^7.55.0"
  }
}
